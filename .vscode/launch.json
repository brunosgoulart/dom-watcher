{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Monitor SCADA - Simulado",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scada_api/server.py",
      "args": [
        "--simulate",
        "--port",
        "8771"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Monitor SCADA — AF SDK",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scada_api/server.py",
      "args": [
        "--config",
        "${workspaceFolder}/scada_api/config.toml",
        "--port",
        "8771"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Interface SCADA",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/interface_preview.py",
      "args": [
        "--port",
        "8770",
        "--api-port",
        "8771"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Dashboard SCADA - PI real",
      "configurations": [
        "Monitor SCADA - AF SDK",
        "Interface SCADA"
      ],
      "stopAll": true
    },
    {
      "name": "Dashboard SCADA - Simulado",
      "configurations": [
        "Monitor SCADA - Simulado",
        "Interface SCADA"
      ],
      "stopAll": true
    }
  ]
}
